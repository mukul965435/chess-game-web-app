<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    
    <div class="game-container">

        <!-- Header Panel: Player Info & Status -->
        <div class="header-panel">
            <div class="player-info" id="playerInfo">
                <span>⚡</span> Connecting to server...
            </div>
            <div class="turn-indicator" id="turnIndicator">
                Turn: White
            </div>
            <div class="game-status" id="gameStatus"></div>
        </div>
    
        <!-- Chessboard Area -->
        <div class="board-wrapper">
            <div class="chessboard"></div>
        </div>
    
        <!-- Controls Panel -->
        <div class="controls-panel">
            <button id="restartBtn" class="btn-primary">
                <span>🔄</span> Restart Game
            </button>
        </div>
    
    </div>

    <!-- Move Audio Sound -->
    <audio id="moveSound" preload="auto">
        <source src="https://assets.mixkit.co/active_storage/sfx/2070/2070-preview.mp3" type="audio/mpeg">
    </audio>

    <!-- Local Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chess.min.js"></script>
    <script src="/js/chessgame.js"></script>
    
</body>
</html>